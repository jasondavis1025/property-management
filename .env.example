# PostgreSQL — replace YOUR_PASSWORD with your pgAdmin postgres user password.
# If the password contains @ # : / or similar, URL-encode it (e.g. @ → %40).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/resident_portal

# Used to sign login cookies — at least 32 characters; keep private in production
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Stripe — https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret (stripe listen locally, or Dashboard → Webhooks in production)
STRIPE_WEBHOOK_SECRET=whsec_...

# Checkout return URLs (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: card only — STRIPE_PAYMENT_METHODS=card
# STRIPE_PAYMENT_METHODS=card,us_bank_account

# Protects POST /api/cron/charge-rent in production
CRON_SECRET=change-me-for-production
